package "Standalone repository distribution (2026-10-05)" {
    class "RepositorySpec (Python)" as DistributionSpec
    class "SourceSelection (Python)" as DistributionSelection
    class "RepositoryBuilder (Python)" as DistributionBuilder
    class "DotnetHost (Python)" as DistributionHost
    class "EffectCache (Python)" as DistributionEffectCache
    class "UnityExport (Python)" as DistributionUnityExport
    class "CloneVerification (Python)" as DistributionVerification
    class "GitHubClient (Python)" as DistributionGitHub
    class "RepositoryPublisher (Python)" as DistributionPublisher
    artifact "SOURCE_MANIFEST.json" as DistributionManifest
    artifact "repository.json" as DistributionConfiguration
    DistributionBuilder --> DistributionSpec : eight independent repository definitions
    DistributionBuilder --> DistributionSelection : current sources and local dependencies
    DistributionBuilder --> DistributionManifest : relative source paths and SHA-256
    DistributionBuilder --> DistributionConfiguration : standalone startup settings
    DistributionEffectCache --> DistributionHost : compile and run bundled effect core
    DistributionUnityExport --> DistributionConfiguration : explicit integration export only
    DistributionVerification --> DistributionConfiguration : fresh clone startup and sample tests
    DistributionVerification --> DistributionManifest : byte preservation and C# dependencies
    DistributionPublisher --> DistributionGitHub : authenticated private repository creation
    DistributionPublisher --> DistributionVerification : validated snapshot before upload
    note as DistributionBoundary
      No submodule, symlink or sibling repository is required.
      Original working tree and protected motion JSON remain intact.
      Unity output may use UNITY_PROJECT_ROOT; authored inputs stay local.
      Training inputs and shared battle sources are bundled snapshots.
      Game assets above the size threshold are tracked through Git LFS.
    end note
    DistributionBoundary .. DistributionBuilder
}

package "LearningLab fixed-party controls (2026-10-06)" {
