        + movementStyle : swim
        + keys : PoseKey[9]
    }
    class CrocodileIdleClip <<MotionClip>> {
        + duration : 3.6 seconds
        + keys : PoseKey[7]
    }
    class CrocodileKnockbackClip <<MotionClip>> {
        + duration : 1.4 seconds
        + keys : PoseKey[8]
    }

    CrocodileSecondaryMotionBuilder ..> MotionStatusRepository : checks protected status
    CrocodileSecondaryMotionBuilder --> CrocodileMotionDocument : replaces move, idle, and knockback only
    CrocodileMotionDocument *-- CrocodileMoveClip
    CrocodileMotionDocument *-- CrocodileIdleClip
    CrocodileMotionDocument *-- CrocodileKnockbackClip
    CrocodileMoveClip ..> CharacterRig : drives tail and alternating paddle strokes
    CrocodileIdleClip ..> CharacterRig : drives breathing, head watch, and jaw
    CrocodileKnockbackClip ..> CharacterRig : drives skid, tail counter-swing, and leg brace
}

