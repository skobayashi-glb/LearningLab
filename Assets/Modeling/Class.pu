        }
        class ToxicVentEffectGenerator {
            - 毒: 予兆輪から三本の噴出柱が時間差で立ち、笠と落下滴に分かれる
        }
        class VenomHitEffectGenerator {
            - 毒専用命中: 衝突球 -> 放物線状の毒滴 -> 地面の残留染み
        }
        class ArcCoilEffectGenerator {
            - 感電・方向攻撃: 溜め輪 -> 螺旋電流の射出 -> 先端の分岐放電(+X正面)
        }
        class StaticCrawlEffectGenerator {
            - 感電・対象付着: 帯電ケージ上を短い弧が滑り、周期的に外へ放電する
        }
        class VoltageClimbEffectGenerator {
            - 感電・全身通電: 接地輪から四本の階段状電流が昇り、頭上で放電冠になる
            - 先頭を明るく後続を暗くして昇る向きを読ませる
        }
        class GroundArcEffectGenerator {
            - 感電: 地面を電流が再帰的に枝分かれして樹状に伝う
        }
        class FrostBloomEffectGenerator {
            - 冷却・地面凍結: 雪華が広がり、中心と六端から結晶花が時間差で立つ
        }
        class HailFallEffectGenerator {
            - 冷却: 立方体∩正八面体の雹が回転落下し、地面で砕ける
            - 支配軸で面を分けるのでアンリットでも角が読める
        }
        class FrostCreepEffectGenerator {
            - 冷却・対象付着: 接地輪から霜枝が這い上がり、先端結晶と凍結襟で閉じる
        }
        class ShardVolleyEffectGenerator {
            - 冷却・弾幕: 装填扇から回転氷片が残像を引いて飛び、終端で破砕する(+X正面)
        }
        class FrostBreathEffectGenerator {
            - 冷却・扇状ブレス: 渦輪と流動結晶が前進し、終端で霜紋になる(+X正面)
        }
        class IceWallEffectGenerator {
            - 冷却・遮蔽物: 予兆亀裂から破片を伴ってせり上がり、上端に結晶が伸びる
        }
        class SandBlastEffectGenerator {
            - 砂まみれ: 円錐状に開いた砂粒を前方へ叩きつける(+X正面)
            - 粒は流れ続け、奥ほどまばらで暗い
        }
        class SandPitEffectGenerator {
            - 砂まみれ: すり鉢が渦を巻いて沈む
            - 地面より下は描けないので縁を持ち上げて内側を沈める
        }
        class SandBurialEffectGenerator {
            - 砂まみれ: 降り注ぐ砂粒と、積み上がる砂山を同時に描く
        }
        class VertigoSpiralEffectGenerator {
            - 朦朧: 傾きが時間で変わる螺旋が対象を包んで回る
        }
        class DazeRippleEffectGenerator {
            - 朦朧: 角度ごとに半径が揺れる輪が次々と広がる
            - 広がるほど歪みが増すので視界の乱れとして読める
        }
        class HeadSpinEffectGenerator {
            - 朦朧: 軸と大きさの違う輪が頭上で交差しながら周回する
        }
        class BlurAfterimageEffectGenerator {
            - 朦朧: 縦長の輪郭線を奥行き方向へずらして重ねる
            - 中身を塗らないので像の枚数とずれ幅が常に読める
        }
        class CurseNailsEffectGenerator {
            - 呪い: 球面の各所から釘が一本ずつ打ち込まれ、刺さり残る
            - 黄金角の螺旋で向きを配るので偏らず重ならない
            - 先細り+先端を暗くしてアンリットでも刺さる向きが読める
        }
        class HexSigilEffectGenerator {
            - 呪い: 多角形と星型の弦が順に刻まれ、刻み終えて脈打つ
        }
        class GraveHandEffectGenerator {
            - 呪い: 地面から腕が伸び、指が開いてから握り込む
        }
        class SoulChainEffectGenerator {
            - 呪い: 縦横を交互にした輪の鎖が前方へ伸び、張って締まる(+X正面)
        }
        class CurseBrandEffectGenerator {
            - 呪い: 宙に立つ紋章が縁から順に焼き付き、スポークが回る
        }
        class DoomOrbEffectGenerator {
            - 呪い: 頭上で凝った球が脈打ち、尾を引いて落ちて環になる
        }
        class ShadeVeilEffectGenerator {
            - 呪い: 影が外周から中心へ閉じ、届いた先で幕として立ち上がる
        }
        class LumenMotesEffectGenerator {
            - 光蝕・補助付着: 外から光粒が集まり、収縮軌道帯と中心光印へ変わる
        }
        class RefractionFanEffectGenerator {
            - 光蝕・扇攻撃: 入射光 -> プリズム核 -> 時間差の分光扇+終端閃光(+X正面)
            - 条ごとにシアン・桃・紫を割り当て、弧状の光で連結する
        }
        class BonitoPrismImpactEffectGenerator {
            - カツオ専用・光蝕: 圧縮リング -> 一本の衝突閃光 -> 円波(+X正面)
            - 銀青色の単一シルエットで突進の命中方向を明示する
        }
        class CatfishSeismicMudUpheavalEffectGenerator {
            - ナマズ専用・地震: 二本のひげ状地割れ -> 二重の泥砂隆起 -> 余震
            - 対象地点に固定し、砂礫を跳ね上げて砂まみれを表現する
        }
        class ClioneBuccalConeAmbushEffectGenerator {
            - クリオネ専用・捕食: 頭頂展開 -> 六本の口円錐伸長 -> 包囲収束 -> 六芒呪印
            - +X固定距離形状をhead上端から対象方向へ向け、飛び道具化しない
        }
