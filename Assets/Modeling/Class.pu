    class "PartyRouteBoard (persistent routes / bindings)" as LabRouteBoard
    class "BattleRoute (origin / waypoints / destination)" as LabRoute
    class "PartyControls (default capacities and energy interval)" as LabPartyDefaults
    BattleLabEnvironment --> LabRouteBoard : select / edit / remove; all decisions advance time
    BattleLabSimulation *-- LabRouteBoard
    BattleLabSimulation *-- LabFixedParty : no draw / consume / death return
    LabRouteBoard *-- LabRoute : three route slots, two waypoints
    LabRouteBoard --> BattleLabGrid : concatenate walk paths and select rejoin cell
    LabRouteBoard --> BattleLabSimulation : read-only battle context (bases / units / squads)
    LabRouteBoard --> BattleLabEntities : route binding / per-unit path / monotonic progress
    BattleLabData --> LabPartyDefaults
    LabFixedParty --> LabPartyDefaults
    BalanceScriptedPolicy ..> LabFixedParty : target first, then cyclic slot order; immediate deploy
    note as LabPartyMigration
      battle data v2 / observation schema battle-v3-party-routes / tool v0.2.0.
      No commit, cards, discard, ally five-squad limit, or zero-time drafts.
      Enemy squad limit remains separate. Energy recovers every simulation second.
      Envelope overflow fails the experiment; old snapshots/checkpoints are incompatible.
      Historical balance results stay unchanged and require new-condition evaluation.
    end note
    LabPartyMigration .. LabRouteBoard
}

package "LearningLab two fixed corridor stages (2026-10-07)" {
    artifact "RL_Straight / RL_UnitStaircase (StageDefinition assets)" as LabCorridorStages
    artifact "battle_setup / defense_training_stages (two maps, all splits)" as LabCorridorSetups
    BattleLabExporter ..> LabCorridorStages : load saved terrain / rotated enemy footprint and spawn
    BattleLabExporter ..> LabCorridorSetups : export six scenarios from two exact map assets
    LabConfig ..> LabCorridorSetups : explicit shared_layouts mode; identical parameters per family
    LabTrainer --> LabConfig : exclude validation / holdout seeds from training sampler
    LabEvaluator --> LabConfig : split-specific evaluation seeds
    BalanceParameterSearch --> LabConfig : preserve shared-layout scope in report
    note as LabCorridorScope
      Straight corridor and staircase alternating one cell right, one cell up.
      One-cell width outside base footprints; no branch, shortcut or terrain randomness.
      Two fixed layouts shared by train / validation / holdout, with disjoint seeds.
      This evaluates fixed layouts; it is not unseen-layout generalization.
      Default disjoint_families mode keeps the existing leakage guard.
      Previous map results remain historical; export a fresh config/run (tool 0.2.1).
    end note
    LabCorridorScope .. LabCorridorStages
}

package "LearningLab single opening wave parameter comparisons (2026-10-07)" {
    class "SingleWaveEncounter (Python)" as LabSingleWaveEncounter
    class "OpeningWave (C# data)" as LabOpeningWave
    IdentityCampaign --> LabSingleWaveEncounter : per-target army-count patterns and audited pools
    BalanceRoleEvaluator --> LabSingleWaveEncounter : same case and seed produce candidate-independent armies
    LabSingleWaveEncounter ..> BattleLabData : opening_wave; disabled enemy AI; sampled party
    BattleLabData *-- LabOpeningWave : optional; normal PPO controls remain separate
    BattleLabSimulation --> LabOpeningWave : register both armies once at reset; spawn-port queue
    BalanceRoleEvaluator --> BattleLabAdapter : wait only; no additional sortie decisions
    note as LabSingleWaveScope
      Tool 0.3.0: 1v1, 1v3, 3v1, 3v3; target always exposed.
      Allies and enemies sampled with replacement from audited supported pools.
      Thirty supported characters; twelve unsupported mechanics remain explicitly excluded.
      Eight parameter targets remain separate from matchup sampling pools.
      Enemy baseline stays frozen; nominal cost remains a scoring input without energy gating.
      Historical cyclic-sortie experiments remain unchanged; regenerate config/run.
    end note
    LabSingleWaveScope .. LabSingleWaveEncounter
}

package "LearningLab online parameter proposal learning (2026-10-09)" {
    class "RangeParameterSpace (bounded integer / real domain)" as LabRangeSpace
    class "AdaptiveProposalLearner (latent Gaussian, score-function / Adam)" as LabAdaptiveProposal
    LabRangeSpace --|> BalanceParameterSpace : shared baseline validation and change penalty
    IdentityCampaign --> LabRangeSpace : authored bounds; frozen speed / cost / mechanics
    BalanceParameterSearch --> LabAdaptiveProposal : ask / full train evaluation / tell before next proposal
    LabAdaptiveProposal --> LabRangeSpace : sigmoid latent sample and integer decoding
    BalanceParameterSearch --> BalanceRoleEvaluator : validation / joint validation / final holdout only
    LabAdaptiveProposal --> LabArtifacts : optimizer, distribution, RNG checkpoint after feedback
    note as LabAdaptiveScope
      Tool 0.4.0: learned proposal mean and log standard deviation, no fixed candidate list.
      One baseline reference evaluation followed by budget minus one distribution updates.
      Only train scores update the distribution; validation and holdout never backpropagate.
      Select an evaluated candidate, never the unevaluated distribution center.
      Existing single opening waves, audited pools and two stages remain fixed.
      Checkpoints support state restoration; balance CLI resume is not implemented.
    end note
    LabAdaptiveScope .. LabAdaptiveProposal
}

package "Unity Editor authored learning strengths (2026-10-11)" {
    class "CharacterStrengthWindow (Editor-only)" as LearningStrengthWindow
    class "CharacterStrengthRepository (validated JSON / atomic save)" as LearningStrengthRepository
    artifact "LearningLab/configs/strength_assignments.json" as LearningStrengthAssignments
    CharacterBalanceWindow --> LearningStrengthWindow : open authored strength editor
    LearningStrengthWindow --> LearningStrengthRepository : load / edit / explicit save
    LearningStrengthWindow --> UnitDataCollector : display names from ally assets
    LearningStrengthRepository --> LearningStrengthAssignments : shared source; preserve keys and metadata
    IdentityCampaign --> LearningStrengthAssignments : --strengths or default file; frozen per new campaign
    note as LearningStrengthEditorScope
      weak / standard / strong / conditional per registered character.
      No game stat mutation or automatic application to existing experiments.
      Standalone game clones explicitly select the LearningLab JSON location.
      External edits since load reject save; editor close prompts for unsaved changes.
    end note
    LearningStrengthEditorScope .. LearningStrengthWindow
}

package "LearningLab observed character search (2026-10-12)" {
    class "SearchObserver (optional hooks)" as LabSearchObserver
    class "FileSearchMonitor (real-state frames / progress / trial history)" as LabFileMonitor
    class "SearchControl (condition-based pause / resume / stop)" as LabSearchControl
    class "DashboardService (HTTP + one search worker)" as LabDashboardService
    artifact "Loopback WebUI (stage canvas / time scrubber / distribution charts)" as LabDashboardUI
    LabFileMonitor --|> LabSearchObserver
    LabFileMonitor *-- LabSearchControl
    BalanceParameterSearch --> LabSearchObserver : started / trial / completion notifications
    BalanceRoleEvaluator --> LabSearchObserver : real debug snapshots; checked decision boundaries
    LabFileMonitor --> LabArtifacts : monitor.json / episodes.jsonl / per-episode frame files
    LabDashboardService *-- LabFileMonitor
    LabDashboardService --> BalanceParameterSearch : existing numerical-search workflow
    LabDashboardUI --> LabDashboardService : loopback JSON APIs / safe controls
    note as LabDashboardScope
      Tool 0.5.0: view actual host positions, HP, spawn state and attack state in 2D.
      Capture initial / sampled / terminal states without changing scores or gradients.
      Archive frames by episode; scrub historical times with automatic following disabled.
      Pause/resume keeps the same in-memory episode and optimizer; stop retains completed trials.
      No process-restart resume or Unity-rendered 3D frames; no game stat application.
    end note
    LabDashboardScope .. LabDashboardUI
}

package "Authored costs and character-specific budget learning (2026-10-12)" {
    class "BudgetArmyBuilder (exact budget / unique party capacity)" as LabBudgetArmyBuilder
    class "BudgetWaveEncounter (shared opponents / reversed legs)" as LabBudgetWaveEncounter
    class "CharacterProposalLearner (one Adam and RNG per character)" as LabCharacterProposalLearner
    class "preserved_validation (aggregate / character / case tolerances)" as LabBudgetValidation
    class "RosterAnalyzer (measured matchup / pair advantage / selection rate)" as LabRosterAnalyzer
    LabBudgetWaveEncounter --> LabBudgetArmyBuilder : identical spent budget on both sides
    BalanceRoleEvaluator --> LabBudgetWaveEncounter : target included; opponents independent of target
    BalanceParameterSearch --> LabCharacterProposalLearner : only the corresponding character score updates its optimizer
    LabCharacterProposalLearner --> LabAdaptiveProposal : per-character range, optimizer and checkpoint state
    BalanceParameterSearch --> LabBudgetValidation : same rule for isolated and combined validation
    BalanceParameterSearch --> LabRosterAnalyzer : separate analysis seeds; never train or adopt from analysis
    LabRosterAnalyzer --> LabBudgetArmyBuilder : affordable focused and paired armies
    LabRosterAnalyzer --> LabFileMonitor : measured cells / records / partial progress
    LabDashboardUI --> LabDashboardService : analysis API / cost scatter / matchup / roster advantage / adoption
    LearningStrengthRepository --> LearningStrengthAssignments : authored costs 1 to 20 alongside strengths
    SortieEnergyPlan --> SortieEnergyWallet : character cost max 20; energy capacity 30
    note as LabBudgetScope
      Tool 0.6.0. Low 1-5, middle 8-12, high 15-20 authored cost tiers.
      Equal budget 30; one opening registration, no deployment timing AI.
      Enemy reference is a frozen copy of authored ally mechanics and statistics.
      Two reversed legs separate actor strength from side advantages.
      Roster selection rate is not player usage; pair advantage is not isolated causal synergy.
      Missing or unaffordable measurements are blank, never zero.
    end note
    LabBudgetScope .. LabRosterAnalyzer
}

@enduml
