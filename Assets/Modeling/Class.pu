package "Stage Authoring" {
    class StageDefinition <<ScriptableObject>> {
        + StageId : string
        + StageProgress : int
        + Width : int
        + Height : int
        + BoardCenterOffsetCells : Vector2
        + InitialViewZoomMultiplier : float
        + HasStageVictoryConditions : bool
        + VictorySettings : StageVictorySettings
        + LightingSettings : StageLightingSettings
        + GetTerrain(position) : StageTerrainCell
        + SetTerrain(position, terrain)
        + Resize(width, height, addedCellTerrain)
        + PlacePlayerBase(position)
        + PlaceEnemyBase(type, position)
        + SetVictoryConditions(...)
        + SetLightingSettings(settings)
    }
    class StageLightingSettings <<ScriptableObject>> {
        + SunIntensity / SunColor
        + BrightnessSteps / LightingPixelSize / AdditionalLightStrength
        + BlueFireColor / BlueFireIntensity / BlueFireRange
        + BlueFireIntensitySteps / BlueFirePositionJitter / BlueFireJitterSpeed
    }
    class StageCatalog <<ScriptableObject>> {
        + TryResolve(stageProgress, definition) : bool
        + TryGetBoardEnvelope(envelope) : bool
        + Register(definition)
        + Unregister(definition)
    }
    class StageDefinitionCompiler <<runtime service>> {
        + Compile(definition) : StageGenerationData
    }
    class StageDefinitionValidator <<shared validation>> {
        + Validate(definition, enemyBaseDataProvider) : StageValidationIssue[]
    }
    interface IEnemyBaseDataProvider {
        + TryGet(type, data) : bool
    }
    class StageDefinitionEditorWindow <<Unity Editor>> {
        - DrawCanvas(rect)
        - DrawCursorPreview(rect)
        - DrawActiveBrushLabel(rect)
        - DrawSortiePortal(origin, facing, canvas)
        - ApplyBrush(cell)
        - ApplyFill(cell)
        - CycleBrush(wheelDelta)
        - IsCurrentBrushValidAt(cell) : bool
        - RotatePlacement(cell)
        - RunValidation()
        - ブラシ「拠点を回す」と R キーで90度ずつ向きを変える
        - 出撃口の向きはセルの縁の帯で示す
    }
    enum BaseFacing {
        North / East / South / West
    }
    class BaseFacings <<static>> {
        + YawDegrees(facing) : float
        + Rotation(facing) : Quaternion
        + Rotate(offset, facing) : Vector2Int
        + ForwardCell(facing) : Vector2Int
        + Next(facing) : BaseFacing
        + DisplayName(facing) : string
    }

    StageDefinitionEditorWindow --> BaseFacings : rotates placements
    StageDefinitionEditorWindow --> StageLightingSettings : 光設定アセットを選択
    StageDefinition --> StageLightingSettings : ステージ固有の光設定
    StageDefinitionCompiler --> StageLightingSettings : 実行時データへ引き渡す
    Stage --> VoxelLightingController : ステージ生成時に光設定を適用
    StageDefinition --> BaseFacing : per placement facing
    StageDefinitionCompiler --> BaseFacing : carries facing into generation
    Stage --> BaseFacings : Instantiate rotation
    TerritoryBase --> BaseFacings : rotates footprint and spawn slots
    StageDefinitionValidator --> BaseFacings : validates rotated cells

    note right of BaseFacings
        拠点の向きは出撃口(SortiePortal)の向きそのもの。
        prefabの子Transformを回すので、向きを変えると出撃開始地点が変わる。
        占有マスと出撃スロットのオフセットも同じ回転で合わせる。
    end note
    class StageEditorAssetUtility <<Unity Editor>> {
        + CreateNewStage() : StageDefinition
        + Duplicate(source) : StageDefinition
        + ImportLegacyStage() : StageDefinition
        + RegisterInCatalog(definition)
        + UnregisterFromCatalog(definition)
        + Delete(definition) : bool
        - 新規・取込時に専用StageLightingSettingsを作成
        - 複製時は光設定も複製してステージ間の共有を防ぐ
        - 削除は確認のうえ、カタログ登録を外してから資産を消す
    }
    class EditorEnemyBaseDataProvider <<Unity Editor>>
    class Stage <<MonoBehaviour>> {
        + HasStageVictoryConditions : bool
        + VictorySettings : StageVictorySettings
        + IsBossBaseCaptured : bool
    }
    class TerrainBuilder
    note right of TerrainBuilder
        固定岩の初回生成時に、登録済みコンテンツの除外境界でセル群を分割する。
        岩塊が境界をまたがないため、塊単位の退避でも隙間や重複を作らない。
        固定岩の除外形状は盤面本体だけとし、盤面外のセルを欠けなく残す。
        固定外周岩の高さ倍率を上限1.2へ制限し、分割後の小岩塊の過剰な高さを防ぐ。
        盤面岩は1ボクセル、固定外周岩は2ボクセル厚の連続基礎層を持ち、境界の裾を接続する。
        固定外周岩は通行可能境界で後退させず、盤面セル境界へ隙間なく接続する。
        固定外周の岩は共通グリッド基準高に置き、ちらつき防止の深度補正は床だけに適用する。
        岩塊の分割・除外・遷移所属はワールドBoundsではなく整数セルのRectIntで判定する。
    end note
    class PersistentTerrainEnvironment <<runtime service>> {
        + Root : Transform
        + PrepareTransition(incomingExclusionRegions: RectInt[], outgoingMotionRoot)
        + ApplyLayout(exclusionRegions: RectInt[])
        + ReclaimMotionMasses()
        - Non-excluded exterior masses always return to the persistent fixed layer
    }
    class RockTerrainPlacement {
        + Masses : IReadOnlyList<RockTerrainMass>
    }
    class RockTerrainMass {
        + IsExcluded : bool
        + Intersects(region: RectInt) : bool
        + SetExcluded(excluded)
        + AttachToMotionRoot(root)
        + RestorePersistentTransform()
    }
    enum RockTerrainRenderMode {
        ChunkedContent
        PersistentMasses
    }
    class StageViewCenterResolver <<layout service>> {
        + Resolve(camera, fallbackCenter) : Vector3
        + ResolveBoardCenter(camera, fallbackCenter, width, height, cellSize) : Vector3
        + ResolveLegacyBoardCenter() : Vector3
        - 盤面四隅の透視投影Bounds中心がViewport中央へ一致するよう生成中心を反復補正
    }
    class GridMath <<board coordinate service>> {
        + BoardBounds : RectInt
        + WorldOrigin : Vector3
        + ConfigureBoard(bounds, fixedWorldCenter)
        + CellToWorld(cell) : Vector3
        + WorldToCell(position) : Vector2Int
        + ClampToBoard(cell) : Vector2Int
    }
    note right of GridMath
        Stageは初回グリッド原点を固定し、奇数・偶数サイズが切り替わっても
        後続盤面を同じワールドセル格子へスナップする。
    end note
    class CameraMover <<fixed view controller>> {
        + ApplyInitialViewZoom(zoomMultiplier)
        + ApplyInitialViewForNewStage(zoomMultiplier)
        - 透視投影は基準距離、平行投影は基準orthographicSizeへ倍率を適用
    }
    class EnemyBaseData <<ScriptableObject>>

    StageDefinitionEditorWindow --> StageDefinition : edits terrain and placements
    StageDefinition o-- StageVictorySettings : ボス拠点と残存敵拠点数の複合条件
    StageDefinitionEditorWindow --> StageDefinitionValidator : validates before play
    StageDefinitionEditorWindow --> StageEditorAssetUtility : creates and imports assets
    StageEditorAssetUtility --> StageCatalog : registers and unregisters definitions
    StageEditorAssetUtility --> StageLightingSettings : ステージごとの設定アセットを生成・複製
    StageCatalog o-- StageDefinition
    Stage --> StageCatalog : resolves by stage progress
    Stage --> StageDefinitionCompiler : builds runtime data
    Stage --> StageViewCenterResolver : resolves perspective-correct board generation center
    Stage --> GridMath : configures per-stage board origin
    StageDefinitionCompiler --> StageDefinition
    StageDefinitionCompiler --> StageVictorySettings : 実行時データへ複製
    Stage --> StageVictorySettings : 現在ステージの条件を公開
    Stage --> TerrainBuilder : supplies compiled map
    Stage *--> PersistentTerrainEnvironment : 次盤面と重なる岩塊だけを旧遷移ルートへ貸し出す
    Stage --> PersistentTerrainEnvironment : 次盤面と重なる表示中岩塊を沈降直前に旧ルートへ所属変更
    StageCatalog --> StageDefinition : calculates registered board envelope
    PersistentTerrainEnvironment o-- RockTerrainMass : 塊単位で固定層と遷移ルート間を貸し借り
    TerrainBuilder --> RockTerrainPlacement : returns persistent mass handles
    RockTerrainPlacement o-- RockTerrainMass
    TerrainBuilder ..> RockTerrainRenderMode : selects persistent mass rendering
    TerrainBuilder ..> GridMath : terrain parent uses configured world origin
    StageDefinitionValidator --> IEnemyBaseDataProvider
    EditorEnemyBaseDataProvider ..|> IEnemyBaseDataProvider
    EditorEnemyBaseDataProvider --> EnemyBaseData : reads footprint and spawn slots
}

package "Character Portrait Capture (Editor)" {
    class CharacterPortraitCaptureWindow <<EditorWindow>> {
        + Tools/Characters/Capture Portraits
        - ドラッグで方位/仰角、ホイールで寄り引き、中ドラッグで位置合わせ
        - プレビューと書き出しが同じ経路なので、見えたものがそのまま保存される
        - 「この向きを覚える」でキャラ単位の向きを設定へ保存する
    }
    class CharacterPortraitRenderer {
        + Load(modelName) / Render(settings, yaw, pitch, margin, pan, w, h)
        - 実行時と同じ VoxelCharacterModelLibrary → URP/Texcels で組むので顔つきが一致
        - 編集中のシーンを汚さないようプレビューシーンへ隔離し、光もそこへ置く
        - 縁取りはシルエットの距離で敷いてから元絵を重ねる(VoxelStudioと同じ手順)
    }
    class CharacterPortraitCaptureSettings <<ScriptableObject>> {
        - 投影(透視/望遠/平行) / 方位 / 仰角 / 余白 / パン / 出力サイズ / 透過
        - 縁取り(太さ・色・ぼかし・しきい値) / 光の向きと強さ / 書き出し先
    }
    class CharacterPortraitPose <<Serializable>> {
        + ModelName / Yaw / Pitch / Margin / Pan
        - 横に長い子と縦に高い子で既定の向きが合わないため、キャラ単位で上書きする
    }

    CharacterPortraitCaptureWindow --> CharacterPortraitRenderer
    CharacterPortraitCaptureWindow --> CharacterPortraitCaptureSettings
    CharacterPortraitCaptureSettings o-- CharacterPortraitPose
    CharacterPortraitRenderer --> CharacterVisuals.VoxelCharacterModelLibrary : 実行時と同じ経路
    CharacterPortraitCaptureWindow --> Allies.AllyCharacterCatalog : 撮る対象の一覧
    CharacterPortraitCaptureWindow ..> GameUI.CharacterPortraitLibrary : 書き出し先を共有
}

package "Goblin Simple Slime Downslash" {
    class GoblinSlimeDownslashAttackBuilder <<MotionStudio build tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent()
    }
    class GoblinMotionDocument <<JSON>> {
        + attack.duration : 1.25 seconds
        + attack.keys : PoseKey[7]
        + currentRigBones : 9
        + every bone position : zero
        + motion : wind-up / downslash / recovery
        + technique.statusEffects : slime
        + technique.area : single
    }
    class GoblinSlimeDownslashEffectGenerator <<IVoxelEffectGenerator>> {
        + EffectType : string
        + Generate(spec) : VoxelEffectFrame[]
        - EmitDescendingSlash(...)
        - EmitSmallSplash(...)
        - EmitGroundSmear(...)
    }
    class GoblinSlimeDownslashSpec <<VoxelEffectSpec>> {
        + length / curve / thickness
        + splashRadius / splashHeight / globCount / smearLength
    }
    class GoblinSlimeDownslashEvent <<Motion event>> {
        + anchor : target
        + aim : false
        + targetTravel : false
    }

    GoblinSlimeDownslashAttackBuilder ..> MotionStatusRepository : checks protected status
    GoblinSlimeDownslashAttackBuilder --> GoblinMotionDocument : rebuilds one basic full-rig downslash
    GoblinMotionDocument --> GoblinSlimeDownslashEvent : emits at the single impact
    GoblinSlimeDownslashEvent --> GoblinSlimeDownslashEffectGenerator : goblin_slime_downslash
    GoblinSlimeDownslashEffectGenerator ..> GoblinSlimeDownslashSpec : reads
    GoblinMotionDocument ..> TechniqueProfile : close single-target slime
}

