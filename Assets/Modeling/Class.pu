'==================================================
' Rendering
'==================================================
package "Rendering" {
    class TeamColors <<static>> {
        {static} + Ally / Enemy / ForOwnership()
        {static} + MarkerAlly / MarkerEnemy / MarkerNeutral /
        MarkerContested / MarkerForOwnership()
    }
    class OcclusionProxyBuilder <<static>> {
        {static} + CreateSkinnedProxy<T> / CreateMeshProxy<T>
    }
    abstract class CharacterRenderProxy <<marker>>
    class CharacterOcclusionProxy
    class CharacterOcclusionBlockerProxy
    class MaterialUtility <<static>> {
        {static} + SetFloat / SetColor / SetTexture (HasPropertyガード)
    }
    class CharacterOcclusionVisibility
    class CharacterOcclusionBlocker
    class TerritoryBaseOwnershipOutline <<MonoBehaviour>> {
        {static} + Attach(TerritoryBase)
        - カメラ投影後の拠点外側シルエットだけを所有陣営色で縁取る
        - 味方は青、敵は赤、中立は灰色
        - 所有権変更イベントで色を即時更新
        - MaterialPropertyBlockはMonoBehaviour構築後に遅延生成
    }
    class TerritoryBaseOwnershipOutlineProxy <<marker>>
    class CombatFrontlineUI <<MonoBehaviour>> {
        {static} + Attach(Stage)
        - 戦線の凸包セル領域外周だけを太い赤線で囲う
        - 内部セル境界は描かず、領域全体を連続する赤い斜線で塗る
        - 斜線の太さを含む四角形をセル有効領域でクリップする
        - 新規戦線はセル領域の面積重心から外側へ展開
        - キャラクター位置を毎フレーム再集計して範囲追従
        - 位置変化による追加セルは接続辺を固定して外側へ面展開し、除外セルは同じ辺へ縮退
        - 変化中だけ専用メッシュ範囲を更新し、外周線幅と斜線間隔を一定に維持
    }
    class TerritoryCaptureAreaUI <<MonoBehaviour>> {
        {static} + Attach(Stage)
        - 全拠点の制圧セル内部を陣営非依存の半透明オレンジで塗り、オレンジの外周線を表示
    }
    class GroundOverlayLayering <<policy>> {
        + CaptureAreaHeightOffset
        + RouteHeightOffset
        + RouteDepthLayerSpacing
        + FrontlineHeightOffset
        + CaptureAreaRenderQueue
        + RouteRenderQueue
        + FrontlineRenderQueue
        - 地面→制圧面→戦線→侵攻経路・到達旗の描画優先度を一元管理
    }
    class GroundOverlayLineMeshBuilder <<utility>> {
        {static} + AddSegment(vertices, triangles, start, end, halfWidth)
        {static} + AddOverlappingSegment(vertices, triangles, start, end, halfWidth)
        {static} + AddJoinedSegment(vertices, triangles, start, end, halfWidth, joinedEnds)
        {static} + AddClippedSegment(vertices, triangles, start, end, halfWidth, bounds)
        - 線端ごとの接続指定に応じて必要な側だけ延長する
        - 太さを持つ線分ポリゴンを矩形領域でクリップする
    }
    class PhaseRoutePreviewVisual {
        + LineRenderer CurrentPhaseRoute
        + LineRenderer FutureRoute
        + LineRenderer ArrivalFlag
    }
    class RoutePreviewUtility <<static>> {
        {static} + SetCircle(lineRenderer, ...)
        {static} + CreateFlowLine(parent, name, color, width, flowSpeed)
        {static} + CreateFlowLine(..., patternScale, chevron) / SetWorldPath(line, points, lift)
        - 2026-10-02: chevron で山形の矢印(RouteFlow _Shape)、lift で地面から浮かせた線(選んでいる侵攻経路の道のり)
        {static} + CreatePhaseRoutePreview(parent, name, teamColor)
        {static} + ShowPhaseRoute(preview, reachability)
        {static} + BuildLaneOffsets(paths, spacing)
        - 到達位置で経路を分割し、到達前を0.22の太い点線、到達後を細い点線にする
    }
    class PhaseRouteLaneCoordinator <<static>> {
        {static} + Show(preview, reachability)
        {static} + Release(preview)
        - 敵味方の共有セル区間を検出して表示レーンを左右へ分離
        - 同一セル内の曲線サンプルでもレーンoffsetを維持し、チェーン状の中心復帰を防ぐ
        - 曲がり角は前後レーンの交点へ接続し、フェーズ到達位置のoffsetを補間
    }
    class RouteFlowDepth <<MonoBehaviour>> {
        + Initialize(sourceLine)
        + SyncNow()
        - 流れる点線の疑似深度レイヤーと表示状態を同期
    }
    class RouteFlowShader <<shader>> {
        - UV始点から終点へ丸い点を反復移動
    }
    class VisibleObjectSilhouette <<shader>> {
        - 投影後の法線方向へ一定ピクセルだけ外側へ拡張
        - ZTest LEqualでプレイヤーから見える物体境界だけを描画
        - 拠点所有輪郭とキャラクター状態輪郭で共有
    }
    class CausticsDecalProjector <<scene object>> {
        - シーン上の "Caustics Effect"（URP DecalProjector）
        - 水面からの光を地形へ落とす唯一の投影元
    }
    class CausticEffectShader <<shader>> {
        + _Color / _Alpha / _Density / _Offset / _Power
        + _PixelSize / _PosterizeSteps / _AnimationFrameRate
        - ワールドXZを_PixelSizeで量子化してからVoronoiを評価し、
        ドット絵のような正方ピクセルの水面光にする
        - Time * _AnimationFrameRateを床関数で刻み、コマ送りアニメにする
        - Voronoi濃淡をPosterizeで_PosterizeSteps段のべた塗りに落とす
        - URP Decal Projectorから地形へ投影する
    }
    class GroundProjection
    class ProjectedSpriteSurface
    class TubeMeshBuilder <<static>> {
        {static} + Build(mesh, points, radii, colors, sides, ...)
        - 折れ線沿いの低ポリ角柱チューブ。陰影は頂点カラーへ焼き込み
    }

    CharacterOcclusionVisibility ..> OcclusionProxyBuilder
    CharacterOcclusionBlocker ..> OcclusionProxyBuilder
    TerritoryBaseOwnershipOutline --> OcclusionProxyBuilder : 拠点メッシュの輪郭Proxyを生成
    TerritoryBaseOwnershipOutline --> TeamColors : 所有陣営色
    TerritoryBaseOwnershipOutline --> Bases.TerritoryBase : 所有権変更を購読
    TerritoryBaseOwnershipOutline --> VisibleObjectSilhouette
    CharacterOcclusionProxy --|> CharacterRenderProxy
    CharacterOcclusionBlockerProxy --|> CharacterRenderProxy
    TerritoryBaseOwnershipOutlineProxy --|> CharacterRenderProxy
    CharacterOcclusionVisibility ..> CharacterRenderProxy : Proxyを描画元から除外
    CharacterOcclusionBlocker ..> CharacterRenderProxy : Proxyを描画元から除外
    GroundProjection ..> CharacterRenderProxy : 投影対象から除外
    ProjectedSpriteSurface ..> MaterialUtility
    CombatFrontlineUI --> Battle.CombatGroupRegistry : 現在の最小凸包セル領域を毎フレーム取得
    CombatFrontlineUI --> Battle.CombatFrontZoneSnapshot
    class SortieBaseFrameUI <<MonoBehaviour>> {
        {static} + Attach(Stage) : SortieBaseFrameUI
        + Show(assigned, candidates) / Hide()
        - どの拠点の縁取りを白/薄灰で出し、どれを消すかを決めるだけ
    }
    class SortieBaseModelFrame <<MonoBehaviour>> {
        {static} + GetOrAttach(TerritoryBase) : SortieBaseModelFrame
        + Show(assigned) / Hide()
        - 拠点本体のレンダラーを SilhouetteOutlineTarget で印付けし、白 6px(候補は薄灰)で囲む
        - 描くのは SilhouetteOutlineFeature。ここは色の切り替えだけ
    }
    SortieBaseFrameUI --> SortieBaseModelFrame
    SortieBaseModelFrame --> SilhouetteOutlineTarget
    class SilhouetteOutlineTarget <<static>> {
        {static} + RenderingLayerBit = 1<<5
        {static} + SetSolid(renderer, block, color, width) / SetBands(renderer, block, colors, count, width) / Clear(renderer, block)
        {static} + HasActiveTargets : bool
        - 対象レンダラーにレンダリングレイヤーの1ビットと _Outline* の MaterialPropertyBlock を載せるだけ
    }
    class SilhouetteOutlineFeature <<ScriptableRendererFeature>> {
        {static} + IsRegistered : bool
        - float maximumOutlineWidthPixels = 8 / bool debugShowMask(診断: マスクをそのまま表示)
        - AfterRenderingTransparents に SilhouetteOutlinePass を積む(対象が無ければ何もしない)
        - URP-HighFidelity/Balanced/Performant の各 Renderer アセットに登録
    }
    class SilhouetteOutlineInjector <<static>> {
        - beginCameraRendering で、Feature が未登録のときだけ同じパスを EnqueuePass する保険
    }
    class SilhouetteOutlinePass <<ScriptableRenderPass>> {
        + MaximumWidthPixels / DebugShowMask / IsReady
        {static} + ShouldRender(cameraType) : bool
        - Pass 1 Mask: RenderingLayerBit の対象を override material(SilhouetteOutlineMask)でマスクRTへ。深度テクスチャ比較で見えている部分だけ。RGB=色, A=太さ比
        - Pass 2 Dilate: 全画面(SilhouetteOutlineDilate)でマスクを同心円探索して膨張、対象の外側だけに色を乗せる
        - 頂点押し出しと違い、面の向き・部位の継ぎ目・カメラ角度に左右されず太さが一定で内部線が出ない(2026-09-11)
        - 初回記録時にカメラ名・登録有無・対象数をログ
    }
    SilhouetteOutlineFeature *-- SilhouetteOutlinePass
    SilhouetteOutlineInjector --> SilhouetteOutlinePass : 未登録時の差し込み
    SilhouetteOutlineInjector ..> SilhouetteOutlineFeature : IsRegistered
    class SilhouetteOutlineMask <<shader>>
    class SilhouetteOutlineDilate <<shader>>
    SilhouetteOutlinePass --> SilhouetteOutlineMask : override material
    SilhouetteOutlinePass --> SilhouetteOutlineDilate : 全画面ブリット
    SilhouetteOutlinePass ..> SilhouetteOutlineTarget : RenderingLayerBit で対象を絞る / HasActiveTargets
    class RouteLinesUI <<MonoBehaviour>> {
        {static} + Attach(Stage) : RouteLinesUI
        - 盤面上の経路線を1か所で描く(§15.2)
        - 2026-10-02: 侵攻経路の道のり(SortieCommandController.TryGetRoutePath)。選んでいる経路だけ宙に浮かせる(0.4セル)。地面に影・両端に点線の柱・白い帯の上を山形の矢印(RouteFlow _Shape=1)。他の経路は地面に細く
        - 味方は経路の道のりで見せる(経路に結び付いていない味方だけ残り経路)。敵は部隊ごとの残り経路+旗、出撃予告+出撃セルの印
        - 地面の線は同じ BuildLaneOffsets に載せるので、同じ辺を通っても横に並ぶ。破線密度は RouteDashPatternScale
        - 出現中も切らさない: 始点は RuntimeSquad.TryGetAnchor、IsForming の部隊は隊員0でも描く
        - 共有経路は決定の瞬間に置く(SquadOrderRouter, EnemyCommander.Deploy)。Battle と Ready で表示
    }
    RouteLinesUI --> Battle.RuntimeSquadRegistry : 生存部隊と共有経路
    RouteLinesUI --> Battle.EnemyCommander : PendingForecasts(出撃予告)
    RouteLinesUI --> Battle.SortieCommandController : TryGetRoutePath(経路の道のり)
    RouteLinesUI --> Battle.InvasionRouteBoard : 経路と選択・結び付いていない味方
    RouteLinesUI ..> RoutePreviewUtility : 流れる線(SetWorldPath・lift)・山形の矢印・旗・輪・レーン計算
    class InvasionRouteMarkers <<MonoBehaviour>> {
        {static} + Attach(Stage) : InvasionRouteMarkers
        - 侵攻地点の旗(到達旗の形)と旗の上の字、経由地点の地面の輪と番号(1・2)。字はTextMeshProでカメラへ向ける
        - 足元の波紋: 選んでいる経路=太い旗+輪3重1.8秒、他=輪1重3秒。地点を置いた直後に白い大きい輪1回(ChangedAt)
        - Battle と Ready で表示
    }
    InvasionRouteMarkers --> Battle.InvasionRouteBoard : 経路と選択
    InvasionRouteMarkers ..> RoutePreviewUtility : SetArrivalFlag / SetCircle
    InvasionRouteMarkers --> DisplayFontProvider
    class InvasionRouteColorSettings <<ScriptableObject>> {
        {static} + Current
        + ColorOf(slotIndex) : Color / LetterTextColor / Changed
        - 侵攻経路ごとの色(A水色・B黄緑・C紫)の単一ソース。敵の暖色・奪い合いの金を避けた寒色3色
    }
    InvasionRouteMarkers --> InvasionRouteColorSettings : 旗・輪・番号の色
    RouteLinesUI --> InvasionRouteColorSettings : 経路の道のりの色
    GameUI.InvasionRouteSlotsUI --> InvasionRouteColorSettings : 字のチップの色(変わったら組み直す)
    GameTransition --> InvasionRouteMarkers : ステージ生成でattach
    TerritoryCaptureAreaUI --> Stage.TerritoryCaptureArea : 配置禁止と同じセル集合
    TerritoryCaptureAreaUI --> GroundOverlayLayering : 地面直上の最下位戦術表示
    CombatFrontlineUI --> GroundOverlayLayering : 制圧面より上に戦線を描画
    RoutePreviewUtility --> GroundOverlayLayering : 戦線より上に経路と到達旗を描画
    CombatFrontlineUI --> GroundOverlayLineMeshBuilder : 接続済み外周線と領域内へクリップした斜線
    TerritoryCaptureAreaUI --> GroundOverlayLineMeshBuilder : 途切れない制圧領域外周
    GridDrawer --> GroundOverlayLineMeshBuilder : 交点を塞いだ盤面線
    RoutePreviewUtility ..> PhaseRoutePreviewVisual : 生成・更新
    RoutePreviewUtility --> PhaseRouteLaneCoordinator : 表示経路を登録・解除
    PhaseRouteLaneCoordinator ..> RoutePreviewUtility : 共有区間のレーン計算・再描画
    PhaseRouteLaneCoordinator --> PhaseRoutePreviewVisual : 表示中経路を横断調整
    RoutePreviewUtility ..> RouteFlowDepth : 流れる点線へ疑似深度を追加
    RoutePreviewUtility ..> RouteFlowShader : 点線アニメーション材質
    CausticsDecalProjector --> CausticEffectShader : CausticsEffectMaterial
}

'==================================================
' Debugging (UNITY_EDITOR || DEVELOPMENT_BUILD)
'==================================================
package "Debugging" {
    class GameDebug <<static>>
    class EngagementDebug <<static>>
    class EngagementDebugToggle
    class EngagementRangeDebugRenderer
    class EngagementGizmos <<static>>
    enum CombatMovementSource {
        None / CombatStep / RelieveOverlap / CombatFacing
        ApproachPath / PathWalk / PathCorner / PathTurn
        Knockback / GridCorrection
    }
    class CombatMovementTrace <<static>> {
        + Mark(owner, source, detail, weak)
        + MarkSteering(actor, target, toDest, ally, foe, steering)
        + BeginReason(owner, reason) / EndReason(owner)
        + Sample(units)
        + Dump() : string
    }
    class CombatMovementTraceToggle

    EngagementDebugToggle --> EngagementDebug
    EngagementRangeDebugRenderer --> GameDebug
    EngagementRangeDebugRenderer --> Battle.EngagementRange
    EngagementRangeDebugRenderer --> Battle.BodyBox : ワイヤーフレーム表示
    note bottom of EngagementRangeDebugRenderer
      **描画は LateUpdate で行うこと**
      キャラを動かすのは Update の後に走るコルーチン。Update で線を焼くと
      線だけが1フレーム前の位置と向きになり、本体に追従していないように見える。
      ・円AoEは狙っている相手の着弾点へ描く。常に真正面の最大射程へ描くと
        回転のたびに円が射程ぶんの半径で振り回され、実態とも食い違う。
      ・攻撃形状(紫)は狙う相手がいるときだけ着弾点へ描く。相手がいないのに
        真正面の最大射程へ描くと、キャラと無関係な位置に円が浮き、
        索敵範囲と取り違えられる。届く距離は別色の円で常時表示する。
      ・デバッグ表示の誤りは、そのまま不具合の誤診につながる。
    end note
    CombatMovementTraceToggle --> CombatMovementTrace
    CombatMovementTrace --> GameDebug
    CombatMovementTrace --> CombatMovementSource
    CombatMovementTrace --> Battle.CombatGeometry : 立ち位置帯の実測
    note bottom of CombatMovementTrace
      **後退の原因を実測で特定するための計測器**
      位置・向きを書き換える箇所が Mark を申告し、
      毎フレーム末の Sample が実際の差分と突き合わせる。
      「最寄りの敵から離れた」「敵に背を向けた」フレームだけを残す。
      共通の移動コルーチン(MotionCoroutines)は複数の理由から呼ばれるので、
      呼び出し側が BeginReason/EndReason で理由を宣言し、取り違えを防ぐ。
      ・依存は一方向(計測器→戦闘)。戦闘側は #if で囲んだ申告のみ。
      ・F5=体感の印, F4=隊形オフセットの入切。
        「計測器が拾う異常」と「人が見ている現象」は別物でありうるので、
        印で突き合わせ、切り分けは機能を止めたA/Bで確かめる。

      **カクつきの切り分けも同じ1回の記録で行う**
      reason列で原因の系統を分ける:
        FRAME_HITCH   フレーム時間が伸びた = 描画/負荷側。移動は無罪
        SIM_PAUSED    シミュレーション進み幅が0。その間は止まって見える
        DIRECTION_FLIP 進行方向が急に折れた = 経路や指示の切替
        SPEED_DROP / SPEED_SPIKE 速度の急変 = コルーチンの繋ぎ目
      検出フレームの前後も CONTEXT として連続記録し、
      simMs(シミュレーション進み) と frameMs(実フレーム時間) を併記するので、
      「描画が詰まったのか」「移動指示が飛んだのか」を1行で見分けられる。
    end note
}

'==================================================
' SpriteAnim: 自作2Dスプライトアニメライブラリ (独立)
'==================================================
package "SpriteAnim" {
    class SAAnimator
    class SAUIAnimator
    class SARigInstance
    class SARigUIInstance
    class SAAnimationData
    class SAImporter <<Editor>>

    SAAnimator --> SARigInstance
    SAUIAnimator --> SARigUIInstance
    note bottom of SAAnimationData
        SAsource形式(JSエディタ)と1:1互換の独立ライブラリ。
        World用とUI用の再生系統合(SAPlayback案)は
        Importerの文字列参照リスクがあるため見送り。
    end note
}

'==================================================
' MotionStudio: モーションイベント固有エフェクトのプレビュー
'==================================================
package "MotionStudio (Node tool)" {
    class MotionStudioTimelineUI <<module>> {
        - pointerSession
        + marqueeSelect(range, modifier)
        + dragSelectedItems(deltaTime)
        + dragSelectedKeys(deltaTime)
        + dragSelectedEvents(deltaTime)
        + deleteSelectedKeys()
        + deleteSelectedEvents()
    }
    class TimelineItemSelection {
        - selectedItems : Set<TimelineItem>
        + replace(items) / add(item) / remove(item) / toggle(item)
        + applyRange(items, minTime, maxTime, mode, baseSelection)
    }
    class TimelineItemMoveSession {
        - originalTimes : Map<TimelineItem, time>
        - appliedDelta
        + apply(deltaTime)
        + restore()
    }
    class MotionStudioServer {
        + GET effect-spec(name)
        + POST effect-preview(name, parameters)
        + GET/PUT motion(name)
        + PATCH motion-status(name, status)
        + GET editor-session()
    }
    enum MotionStatus {
        INCOMPLETE
        MOTION_COMPLETE
        COMPLETE
    }
    class MotionStatusRepository {
        - statusFile : motion_status.json
        + getStatus(name) : MotionStatus
        + setStatus(name, status)
    }
    class MotionFileProtectionService {
        - editorToken
        - identityValidator : MotionDocumentIdentityValidator
        + writeMotion(name, document, token)
        + setStatus(name, status, token)
        + synchronizeFileProtection(name, file)
    }
    class MotionDocumentIdentityValidator <<domain service>> {
        + assertMatches(expectedModelName, document)
    }
    class MotionIdentityMismatchError <<domain error>> {
        + expectedModelName
        + actualModelName
    }
    MotionStatusRepository --> MotionStatus
    MotionFileProtectionService --> MotionStatus
    class DistinctAttackBatchAuthoring <<tool>> {
        - characterSpecificAttackDesigns
        + buildAttackKeys(model)
        + printApplyPatch(model)
        - motion_complete / complete登録済みモデルは生成拒否
    }
    class AttackConnectivitySanitizer <<tool>> {
        + preserveRootTranslation()
        + clearChildBoneTranslation()
        + printApplyPatch(model)
    }
    class MotionAttackValidator <<tool>> {
        + validateRigBones()
        + validateKeyAndEventTimes()
        + validateConnectedChildParts()
        + validateEffectSpecsAndFrames()
    }
    class CharacterEffectFramesValidator <<tool>> {
        + validateSpecAndPalette()
        + validateFiniteUniqueVoxels()
        + reportFrameAndVoxelCounts()
    }
    class EffectPreviewBaker {
        + generate(effectName, parameters) : Promise<frames>
        - mergeParameters(sourceSpec, parameters)
        - runBaker(tempSpec, tempFrames)
        - bakedFramesAreStale(effectName, surfaceModel, framesFile)
        - スペックまたは体表モデルより古いbake結果は自動再生成へ回す
    }
    class AtlanticTarponDazeAttackBuilder <<tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent(event)
        - 保護状態を確認してから対象JSONだけを更新
    }
    class AtlanticTarponSilverBreakClip <<motion data>> {
        + duration : 1.3 seconds
        + phases : PoseKey[11]
        + effectEvents : DazeRippleEvent[3]
        + statusEffect : dazed
    }
    class BlueSharkStormWakeAttackBuilder <<tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent(event)
        - 保護状態を確認してから対象JSONだけを更新
    }
    class BlueSharkStormWakeClip <<motion data>> {
        + duration : 1.3 seconds
        + phases : PoseKey[12]
        + effectEvents : StormWakeEvent[3]
        + statusEffect : electric
        + positionEffect : knockback
    }
    class BonitoPrismRushAttackBuilder <<tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent(event)
        - 保護状態を確認してから対象JSONだけを更新
    }
    class BonitoPrismRushClip <<motion data>> {
        + duration : 1.2 seconds
        + phases : PoseKey[10]
        + effectEvents : PrismRushEvent[2]
        + statusEffect : lumen
    }
    class CamerocerasDrillWindupAttackBuilder <<tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent()
        - 保護状態を確認してから対象JSONだけを更新
    }
    class CamerocerasDrillAttackClip <<motion data>> {
        + duration : 4.1 seconds
        + windup : 0.00..1.15 seconds
        + drillSpin : 1.25..3.65 seconds
        + oneWayRotationKeys : 24
        + rotationStep : 90 degrees
        + phases : PoseKey[34]
        + effectEvents : DrillSpinEvent[4]
        + effectAnchor : self fixed forward offset
        + targetTravel : false
        + aim : false / rotationY : -90 degrees
    }
    class BullSharkCorkscrewBreakAttackBuilder <<tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent()
        - 保護状態を確認してから対象JSONだけを更新
    }
    class BullSharkCorkscrewBreakClip <<motion data>> {
        + duration : 2.6 seconds
        + coilWindup : 0.00..0.78 seconds
        + headImpact : 0.92..1.08 seconds
        + oneWayCorkscrew : 1.08..1.98 seconds
        + recovery : 1.98..2.60 seconds
        + currentRigBones : 9
        + phases : PoseKey[14]
        + effectEvents : VertigoSpiralEvent[1]
        + statusEffect : dazed
    }
    class CatfishSeismicUpheavalAttackBuilder <<tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent()
        - 保護状態を確認してから対象JSONだけを更新
    }
    class CatfishSeismicUpheavalClip <<motion data>> {
        + duration : 3.0 seconds
        + earthquakeSensing : 0.00..0.65 seconds
        + fullBodyCountertwist : 0.65..1.42 seconds
        + groundSlam : 1.42..1.58 seconds
        + aftershocks : 1.58..2.20 seconds
        + recoveryAndStop : 2.20..3.00 seconds
        + currentRigBones : 11
        + phases : PoseKey[14]
        + effectEvents : SeismicMudUpheavalEvent[1]
        + targetGroundFixed : true
        + statusEffect : sanded
    }
    class ClioneBuccalConeAmbushAttackBuilder <<tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent()
        - 保護状態を確認してから対象JSONだけを更新
    }
    class ClioneBuccalConeAmbushClip <<motion data>> {
        + duration : 2.8 seconds
        + angelicDrift : 0.00..0.50 seconds
        + predatoryCoil : 0.50..0.92 seconds
        + fullBodyFlare : 0.92..1.08 seconds
        + feedingLunge : 1.08..1.22 seconds
        + feedingTwitches : 1.22..1.70 seconds
        + recoveryAndStop : 1.70..2.80 seconds
        + currentRigBones : 5
        + phases : PoseKey[14]
        + effectEvents : BuccalConeAmbushEvent[1] / CurseWispsEvent[1]
        + fixedDistanceFromHead : true
        + headTopOffset : 0.8 world units / 8 voxels
        + statusEffect : curse
    }
    class BlueWhaleFrostBreachAttackBuilder <<tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent()
        - 保護状態を確認してから対象JSONだけを更新
    }
    class BlueWhaleFrostBreachClip <<motion data>> {
        + duration : 4.6 seconds
        + deepDive : 0.00..1.35 seconds
        + breach : 1.35..1.95 seconds
        + frostBreath : 1.95..3.05 seconds
        + recovery : 3.05..4.60 seconds
        + phases : PoseKey[14]
        + effectEvents : FrostBreathEvent[1]
        + fixedBreathDistance : 29 voxels
        + effectDuration : 1.1 seconds
        + statusEffect : chill
    }
    class BowmouthGuitarfishSandPlowAttackBuilder <<tool>> {
        + rebuild()
        - createKey(phase)
        - createEffectEvent()
        - 保護状態を確認してから対象JSONだけを更新
    }
    class BowmouthGuitarfishSandPlowClip <<motion data>> {
        + duration : 2.6 seconds
        + seabedCoil : 0.00..0.75 seconds
        + fullBodyReversal : 0.75..1.08 seconds
        + sandBlast : 1.08..2.08 seconds
        + recovery : 1.55..2.60 seconds
        + phases : PoseKey[11]
        + effectEvents : SandBlastEvent[1]
        + fixedEffectDistance : 30 voxels
        + statusEffect : sanded
    }
    class SkeletonPirateAttackClip <<motion data>> {
        + duration : 5 seconds
        + chargeRattle : 0.00..3.55 seconds
        + overheadSlash : 3.78..4.20 seconds
        + swordPoseKeys : SwordBonePose[]
        + armRightPoseKeys : ArmRightBonePose[]
    }
    class SwordBonePose <<value object>> {
        + rot : EulerXYZ = zero
        + pos : Vector3 = zero
    }
    class ArmRightBonePose <<value object>> {
        + rot : EulerXYZ
        + pos : Vector3 = zero
    }
    class SkeletonPirateRigidRig <<model data>> {
        + root : ImportedRootBone
        + bindings : PartToBoneBinding[7]
    }
    class ImportedRootBone <<rig bone>>
    class ArmRightBone <<rig bone>>
    class SwordBone <<rig bone>>
    MotionStudioTimelineUI --> TimelineItemSelection
    MotionStudioTimelineUI --> TimelineItemMoveSession
    MotionStudioServer --> EffectPreviewBaker
    MotionStudioServer --> MotionFileProtectionService
    MotionFileProtectionService --> MotionStatusRepository
    MotionFileProtectionService *-- MotionDocumentIdentityValidator
    MotionDocumentIdentityValidator ..> MotionIdentityMismatchError : 不一致時
    DistinctAttackBatchAuthoring ..> MotionStatusRepository : 保護状態を参照
    AttackConnectivitySanitizer ..> MotionStatusRepository : 保護状態を参照
    MotionAttackValidator ..> MotionStatusRepository : 保護状態を参照
    CharacterEffectFramesValidator ..> VoxelEffectSpec
    AtlanticTarponDazeAttackBuilder ..> MotionStatusRepository : 保護状態を参照
    AtlanticTarponDazeAttackBuilder --> AtlanticTarponSilverBreakClip : 生成
    AtlanticTarponSilverBreakClip --> DazeRippleEffectGenerator : 命中波紋
    BlueSharkStormWakeAttackBuilder ..> MotionStatusRepository : 保護状態を参照
    BlueSharkStormWakeAttackBuilder --> BlueSharkStormWakeClip : 生成
    BlueSharkStormWakeClip --> LightningEffectGenerator : blue_shark_storm_wake
    BonitoPrismRushAttackBuilder ..> MotionStatusRepository : 保護状態を参照
    BonitoPrismRushAttackBuilder --> BonitoPrismRushClip : 生成
    BonitoPrismRushClip --> BonitoPrismImpactEffectGenerator : bonito_prism_impact
    BonitoPrismRushClip --> ChargeDashEffectGenerator : bonito_prism_wake
    CamerocerasDrillWindupAttackBuilder ..> MotionStatusRepository : 保護状態を参照
    CamerocerasDrillWindupAttackBuilder --> CamerocerasDrillAttackClip : 生成
    CamerocerasDrillAttackClip --> DrillSpinEffectGenerator : drill_spin
    BullSharkCorkscrewBreakAttackBuilder ..> MotionStatusRepository : 保護状態を参照
    BullSharkCorkscrewBreakAttackBuilder --> BullSharkCorkscrewBreakClip : 生成
    BullSharkCorkscrewBreakClip --> VertigoSpiralEffectGenerator : vertigo_spiral / dazed
    CatfishSeismicUpheavalAttackBuilder ..> MotionStatusRepository : 保護状態を参照
    CatfishSeismicUpheavalAttackBuilder --> CatfishSeismicUpheavalClip : 生成
    CatfishSeismicUpheavalClip --> CatfishSeismicMudUpheavalEffectGenerator : 固定地点の地震 / sanded
    ClioneBuccalConeAmbushAttackBuilder ..> MotionStatusRepository : 保護状態を参照
    ClioneBuccalConeAmbushAttackBuilder --> ClioneBuccalConeAmbushClip : 生成
    ClioneBuccalConeAmbushClip --> ClioneBuccalConeAmbushEffectGenerator : 頭部追従の六本口円錐 / curse
    ClioneBuccalConeAmbushClip --> CurseWispsEffectGenerator : 対象地点に残る呪い亡霊
    BlueWhaleFrostBreachAttackBuilder ..> MotionStatusRepository : 保護状態を参照
    BlueWhaleFrostBreachAttackBuilder --> BlueWhaleFrostBreachClip : 生成
    BlueWhaleFrostBreachClip --> FrostBreathEffectGenerator : frost_breath / chill
    BowmouthGuitarfishSandPlowAttackBuilder ..> MotionStatusRepository : 保護状態を参照
    BowmouthGuitarfishSandPlowAttackBuilder --> BowmouthGuitarfishSandPlowClip : 生成
    BowmouthGuitarfishSandPlowClip --> SandBlastEffectGenerator : sand_blast / sanded
    SkeletonPirateAttackClip *-- "14" SwordBonePose
    SkeletonPirateAttackClip *-- "14" ArmRightBonePose
    SkeletonPirateRigidRig *-- ImportedRootBone
    ImportedRootBone *-- ArmRightBone
    ArmRightBone *-- SwordBone : モデル形状から支点を再生成
    SwordBonePose --> SwordBone : ボーン名参照
    ArmRightBonePose --> ArmRightBone : 溜め上昇 / 一振り / 復帰
    note right of MotionFileProtectionService
        motion_complete / complete はAI・自動生成の保存を拒否し、JSONをread-only化。
        MotionStudio画面はセッショントークンにより編集を継続できる。
        状態はモーションJSONと独立して即時切替する。
    end note
    note right of EffectPreviewBaker
        event.effectParamsを元スペックへ差分合成。
        一時ファイルだけを共有C# Bakerへ渡し、
        Assets/Resourcesの正本は変更しない。
    end note
}

'==================================================
' VoxelEffects: プロシージャルボクセルエフェクト
' (Core はUnityEngine非依存の共有コード。EffectStudio/Baker が
'  同じ .cs をコンパイルしてブラウザプレビュー用フレームを焼き出すため、
'  ツールで見た結果とゲーム内の見た目が同一コードで一致する)
'==================================================
package "VoxelEffects" {
    package "Core (UnityEngine非依存)" {
        class EffectVoxel <<struct>> {
            + X / Y / Z : int
            + ColorIndex : int
        }
        class VoxelEffectFrame {
            + Add(voxel) / Contains(x,y,z)
            - 同一座標は先勝ちで重複除去
        }
        class EffectColor <<struct>> {
            {static} + ParseHex("#RRGGBB")
        }
        class VoxelEffectSpec {
            + effectType / framesPerSecond / durationSeconds
            + voxelWorldSize / randomSeed / paletteHex[]
            + targetTravelMode / targetTravelImpactNormalizedTime
            + targetTravelMaxRangeVoxels / targetTravelArcHeightVoxels
            + surfaceTransitionType / surfaceTransitionSourceEffectName
            + surfaceTransitionAdditionalSourceEffectNames[]
            + iceShatterHold / Fracture / Scatter / Cluster / Motion parameters
            + grassCombustionIgnition / Burn / Char / Flame / Spark parameters
            + slimeVenomInfusion / Vein / Bubble / Fade parameters
            + slimeBurstReactionIgnition / Pressure / Chain / Fragment / Spark parameters
            + slimeChargeEnergize / Current / Pulse / Arc parameters
            + bleedInfectionInfusion / LocalSpread / PoisonBand / Pulse / Pustule parameters
            + electricDazeStunBird / Orbit / Height / Bob / Wing parameters
            + bleedCauterizeSweep / Flash / Char / Scar / Evaporation parameters
            + bleedFrostbiteFreeze / BloodPulse / Crystal / Crack parameters
            + grassIceBindFreeze / Rim / Bridge / Knot parameters
            + curseErosionGather / Spread / Close / Branch / Rim / Pulse parameters
            + 衝撃波用パラメータ群(半径・厚み・リップ・デブリ)
            - Resources/VoxelEffects/*.json と1:1のPOCO
        }
        interface IVoxelEffectGenerator {
            + EffectType : string
            + Generate(spec) : List<VoxelEffectFrame>
        }
        class VoxelEffectGeneratorRegistry <<static>> {
            + Resolve(effectType)
            - 新種別は実装+1行登録で追加(OCP)
        }
        interface IVoxelSurfaceTransitionGenerator {
            + TransitionType : string
            + Generate(transitionSpec, sourceSpec, model, partFilter) : VoxelSurfaceTransitionResult
            - 局所遷移はpartFilter内に遷移元がなければnullを返し、そのボーンだけをスキップ可能
            - partFilterなしで遷移元がない場合は設定不備として例外
        }
        interface IMultiSourceVoxelSurfaceTransitionGenerator {
            + Generate(transitionSpec, sourceSpecs, model, partFilter) : VoxelSurfaceTransitionResult
            - 複数状態を消費する遷移だけが利用する拡張契約
        }
        class VoxelSurfaceTransitionResult <<value object>> {
            + Frames : List~VoxelEffectFrame~
            + Palette : EffectColor[]
            + SourceVoxelCount : int
        }
        class VoxelSurfaceTransitionGeneratorRegistry <<static>> {
            + Resolve(transitionType) : IVoxelSurfaceTransitionGenerator
            - 攻撃エフェクト生成器とは別系統で状態遷移を登録する
        }
        class SurfaceTransitionSourceGuard <<static>> {
            + ShouldSkip(hasSource, partFilter, missingSourceMessage) : bool
            - 遷移元が空のときの扱いを全遷移生成器で1箇所に集約
            - partFilterあり(ボーン単位)の空は正常 → true でその部位をスキップ
            - partFilterなし(全身)の空だけ設定不備として例外
        }
        class IceShatterSurfaceTransitionGenerator {
            + TransitionType : ice_shatter
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_chill最終氷膜を同じ座標・色で引き継ぐ
            - 亀裂 / 青白い発光 / 小塊の外向き剥離 / 重力落下
            - Ring・Wave・EffectShapesは生成しない
        }
        class GrassCombustionSurfaceTransitionGenerator {
            + TransitionType : grass_combustion
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_grassの体表座標をそのまま燃焼源にする
            - 葉先側から遅く発火 / 実時間速度の小炎 / 炎先端から赤1ボクセルの火花 / 炭化 / 崩壊消失
            - 燃焼状態の終了フレームで草と炎を消し切る
        }
        class SlimeVenomSurfaceTransitionGenerator {
            + TransitionType : slime_venom
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_slimeの粘液膜を同じ体表座標で引き継ぐ
            - 毒色の浸透 / 膜内を巡る毒脈 / 小泡の膨張と破裂
            - 終盤まで膜を保持し、最後の区間だけ密度を落として消す
        }
        class SlimeBurstReactionSurfaceTransitionGenerator {
            + TransitionType : slime_burst_reaction
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_slimeの粘液膜だけを爆燃の材料にする
            - 着火 / 脈動膨張 / 領域別の連鎖白熱 / 破裂消失
            - 燃えた膜片と赤い1ボクセル火花を外向きへ飛ばす
            - 攻撃用SlimeBurstEffectGeneratorには依存しない
        }
        class SlimeChargeSurfaceTransitionGenerator {
            + TransitionType : slime_charge
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_slimeの粘液膜を同じ体表座標で引き継ぐ
            - 元の膜色を保持 / 通電箇所だけ発光 / 局所的な膜の跳ね / 短い表面放電
            - 膜を領域単位で徐々に消費し、終了フレームで電流と同時に消し切る
        }
        class BleedInfectionSurfaceTransitionGenerator {
            + TransitionType : bleed_infection
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_bleedの初期傷口デカールだけを同じ座標で引き継ぐ
            - 赤い傷を徐々に紫色へ変質させ、その状態を保持する
            - 傷口内部を循環する小さな毒光 / 局所的な脈動
            - 傷口から生じる膿泡の膨張・破裂 / 周囲3ボクセルだけに滲む感染色
            - 猛毒の粘液膜・全身被覆・毒脈・波紋を生成しない
        }
        class ElectricDazeStunSurfaceTransitionGenerator {
            + TransitionType : electric_daze_stun
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_dazedの朦朧を消費して気絶表示へ置き換える
            - 頭上を別位相で周回・上下・羽ばたきする黄色い小鳥3羽
            - 頭部パーツへ追従し、無いモデルではモデル上端へフォールバックする
            - 通常感電の体表電流や固定具を生成しない
        }
        class BleedCauterizeSurfaceTransitionGenerator {
            + TransitionType : bleed_cauterize
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_bleedの初期傷口デカールだけを同じ座標で引き継ぐ
            - 傷口に沿う橙白色の加熱走査 / 血の小粒の上昇蒸発
            - 傷口を間引いて収縮させ、細い黒赤色の焼灼痕を保持する
            - 全身炎・爆発・波紋を生成しない
        }
        class BleedFrostbiteSurfaceTransitionGenerator {
            + TransitionType : bleed_frostbite
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_bleedの初期傷口デカールだけを同じ座標で引き継ぐ
            - 傷口の外側へ短い青白い氷晶を成長させる
            - 氷の内側で赤い血を脈動 / 頂点で氷に濃青色の亀裂を表示
            - 全身氷・氷片の飛散・破砕を生成しない
        }
        class GrassIceBindSurfaceTransitionGenerator {
            + TransitionType : grass_ice_bind
            + Generate(transitionSpec, sourceSpec, model, partFilter)
            - status_grassの確定フレームを彩度の高い緑色の草縄芯として保持する
            - 草縄芯の両側だけへ細い青白い氷縁を成長させる
            - 近接する草を緑芯の橋で接続し、交点を白い氷の結び目で固定する
            - 凍結成長後は完全静止し、全身氷・尖った氷晶・破砕を生成しない
        }
        class LumenCurseErosionSurfaceTransitionGenerator {
            + TransitionType : lumen_curse_erosion
            + Generate(transitionSpec, sourceSpecs, model, partFilter)
            - status_lumenの光蝕粒へstatus_curseの影を収束させる
            - 反転点から金白色の縁を持つ紫黒い枝状亀裂を体表へ広げる
            - 亀裂内部の光を別位相で脈動させ、枝先から閉じる
            - 光蝕と呪いを消費し、最終フレームで完全消失する
        }
