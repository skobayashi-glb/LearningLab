        + Draw(keys, labels, selected, render, repaint) : int
        + Invalidate(key)
        + Dispose()
    }
    class PortraitCaptureFrame <<static>> {
        + Fit(area, aspect) : Rect
        + DrawBackground(rect)
        + DrawBorder(rect, selected, guides)
    }
