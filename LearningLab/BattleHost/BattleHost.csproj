    <Compile Include="../../Assets/Scripts/Battle/Status/StatusDefinition.cs" Link="Shared/StatusDefinition.cs" />
    <Compile Include="../../Assets/Scripts/Battle/Status/StatusReactionDefinition.cs" Link="Shared/StatusReactionDefinition.cs" />
    <Compile Include="../../Assets/Scripts/Battle/Status/StatusReactionCatalog.cs" Link="Shared/StatusReactionCatalog.cs" />
